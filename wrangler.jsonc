{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futplayweb",
  "compatibility_date": "2026-09-16",
  "observability": { "enabled": true },
  "workers_dev": true,

  "assets": {
    "directory": "./dist",

    // Modo SPA: qualquer caminho sem arquivo correspondente devolve o
    // index.html com 200, e o Vue Router assume dali. Sem isto, /peladas
    // redirecionava para a raiz e a rota se perdia ao abrir direto pela URL.
    "not_found_handling": "single-page-application"
  }
}
